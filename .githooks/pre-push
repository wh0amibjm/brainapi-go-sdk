#!/usr/bin/env sh
# Local git pre-push hook. Mirrors the CI gate so commits that bypassed
# pre-commit (--no-verify) still get caught before they leave the laptop.
# Activated by: make install-hooks  (sets core.hooksPath to .githooks/)

set -e

echo "[pre-push] go build ./..."
go build ./...

echo "[pre-push] go test -race (full, no -short)"
go test -race -count=1 -timeout 5m ./...

echo "[pre-push] cross-compile smoke (5 targets)"
out="$(mktemp -d)"
trap 'rm -rf "$out"' EXIT
for target in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64; do
	os="${target%/*}"
	arch="${target#*/}"
	ext=""
	[ "$os" = "windows" ] && ext=".exe"
	echo "  ==> $os/$arch"
	GOOS="$os" GOARCH="$arch" CGO_ENABLED=0 \
		go build -trimpath -ldflags='-s -w' \
		-o "$out/brainapi-$os-$arch$ext" \
		./cmd/brainapi
done

echo "[pre-push] ok"
