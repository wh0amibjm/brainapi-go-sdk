#!/usr/bin/env sh
# Pre-commit hook wrapper -- delegates to the pre-commit framework so the
# hook set is defined exactly once, in .pre-commit-config.yaml. Previously
# this file kept its own hardcoded list of Go checks and the two
# definitions drifted (the stock trailing-whitespace, end-of-file-fixer,
# check-yaml, check-merge-conflict, and check-added-large-files hooks
# existed only on the framework side, so contributors who relied on
# `make install-hooks` without installing the framework got a strictly
# weaker gate).
#
# Install: make install-hooks  (sets core.hooksPath to .githooks/)
# Requires: pre-commit framework -- install via `pip install pre-commit`
# or `uvx pre-commit`. The Makefile target prompts for this if missing.

set -e

if ! command -v pre-commit >/dev/null 2>&1; then
    echo "[.githooks/pre-commit] pre-commit framework not installed." >&2
    echo "  Install: pip install pre-commit  (or  uvx pre-commit)" >&2
    echo "  Then:    make install-hooks" >&2
    exit 1
fi

exec pre-commit run
