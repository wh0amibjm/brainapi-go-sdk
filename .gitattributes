# Go source must have LF line endings so gofumpt/golangci-lint formatters
# (which always emit LF) don't false-flag every file on Windows checkouts
# where core.autocrlf=true would otherwise materialise the worktree as CRLF.
*.go text eol=lf

# Module manifests + sums likewise. Generated by `go mod`, also LF-only.
go.mod text eol=lf
go.sum text eol=lf

# Shell hooks and CI scripts must stay LF or bash refuses to parse them.
*.sh text eol=lf
.githooks/* text eol=lf

# Markdown / YAML / JSON: leave to the user's autocrlf setting (default text);
# editors handle either fine and no tool we run cares.
